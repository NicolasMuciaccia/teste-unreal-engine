# Arquivos-fonte pesados (Blender, Unreal) ficam no Git LFS.
# As fotos de referência são pequenas e ficam no Git normal.
# O modelo final do site (web/public/models/*.glb) NÃO vai para o LFS:
# o GitHub Pages não serve arquivos LFS, só o "ponteiro".
blender/**/*.blend   filter=lfs diff=lfs merge=lfs -text
blender/**/*.blend1  filter=lfs diff=lfs merge=lfs -text
blender/**/*.exr     filter=lfs diff=lfs merge=lfs -text
blender/**/*.hdr     filter=lfs diff=lfs merge=lfs -text
unreal/**/*.uasset   filter=lfs diff=lfs merge=lfs -text
unreal/**/*.umap     filter=lfs diff=lfs merge=lfs -text
